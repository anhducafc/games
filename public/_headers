# Dùng cho Cloudflare Pages và Netlify (GitHub Pages bỏ qua file này).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# File build của Vite có hash trong tên: cache vĩnh viễn.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font, ảnh minh hoạ: cache 1 ngày. SDK và game: luôn hỏi lại (có ETag nên nhẹ) để cập nhật có hiệu lực ngay.
/fonts/*
  Cache-Control: public, max-age=86400
/thumbs/*
  Cache-Control: public, max-age=86400
/sdk/*
  Cache-Control: public, max-age=0, must-revalidate

# Trang chính và mã game không có hash: luôn hỏi lại máy chủ để nhận bản mới.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/games/*
  Cache-Control: public, max-age=0, must-revalidate
